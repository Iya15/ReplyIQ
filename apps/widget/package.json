{
  "name": "widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":          "vite --config vite.config.app.ts",
    "build:loader": "vite build --config vite.config.loader.ts",
    "build:app":    "vite build --config vite.config.app.ts",
    "build":        "pnpm build:loader && pnpm build:app",
    "preview":      "vite preview --config vite.config.app.ts",
    "type-check":   "tsc --noEmit",
    "test":         "vitest run",
    "size-limit":   "size-limit"
  },
  "dependencies": {
    "laravel-echo": "^2.3.4",
    "pusher-js":    "^8.5.0",
    "react":        "19.2.4",
    "react-dom":    "19.2.4",
    "zod":          "^3.25.76"
  },
  "devDependencies": {
    "@replyiq/config":              "workspace:*",
    "@size-limit/preset-small-lib": "^11",
    "@types/node":                  "^20",
    "@types/react":                 "^19",
    "@types/react-dom":             "^19",
    "@vitejs/plugin-react":         "^4.3",
    "@vitest/coverage-v8":          "^3",
    "autoprefixer":                 "^10",
    "jsdom":                        "^26",
    "postcss":                      "^8",
    "size-limit":                   "^11",
    "tailwindcss":                  "^3.4",
    "terser":                       "^5",
    "tsx":                          "^4",
    "typescript":                   "^5",
    "vite":                         "^5",
    "vitest":                       "^3"
  }
}
