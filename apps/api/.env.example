APP_NAME=ReplyIQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=replyiq
DB_USERNAME=replyiq
DB_PASSWORD=secret
DB_SCHEMA=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Session / Cache / Queue ─────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=replyiq_

# ─── Mail ────────────────────────────────────────────────────────────────────
# Development: use Mailpit (https://github.com/axllent/mailpit)
#   brew install mailpit   # macOS
#   SMTP listener: 127.0.0.1:1025
#   Web UI:        http://127.0.0.1:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@replyiq.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AI / Embedding ──────────────────────────────────────────────────────────
# AI_PROVIDER=openai  Supported: openai (default), ollama (dev only — 768d mismatch guard active)
AI_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_ORGANIZATION=
OPENAI_REQUEST_TIMEOUT=60

# Ollama (local dev only — requires a future vector(768) migration before production use)
OLLAMA_HOST=http://localhost:11434

# ─── Supabase Storage (S3-compatible) ────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=replyiq-storage
AWS_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Laravel Reverb (WebSockets) ─────────────────────────────────────────────
REVERB_APP_ID=replyiq
REVERB_APP_KEY=replyiq-key
REVERB_APP_SECRET=replyiq-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# These are read by the Next.js dashboard (apps/web/.env.local).
# Kept here as a reminder — copy to apps/web/.env.local as NEXT_PUBLIC_REVERB_*.
NEXT_PUBLIC_REVERB_APP_KEY="${REVERB_APP_KEY}"
NEXT_PUBLIC_REVERB_HOST="${REVERB_HOST}"
NEXT_PUBLIC_REVERB_PORT="${REVERB_PORT}"
NEXT_PUBLIC_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Stripe / Billing ────────────────────────────────────────────────────────
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

STRIPE_PRICE_STARTER_MONTHLY=price_
STRIPE_PRICE_STARTER_ANNUAL=price_
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_ANNUAL=price_
STRIPE_PRICE_BUSINESS_MONTHLY=price_
STRIPE_PRICE_BUSINESS_ANNUAL=price_

# ─── Security ────────────────────────────────────────────────────────────────
# Optional: Slack webhook URL for escalation notifications
SLACK_ESCALATION_WEBHOOK_URL=

# ─── Observability ───────────────────────────────────────────────────────────
# Sentry DSN — leave empty to disable
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Set to git SHA in CI: SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=

# Better Stack (Logtail) source token
# Production: LOG_STACK=stderr-json,logtail  (JSON to container logs + Logtail)
BETTERSTACK_SOURCE_TOKEN=

# OpenAI cost report: optional Slack webhook for daily cost summary
SLACK_COST_WEBHOOK_URL=
