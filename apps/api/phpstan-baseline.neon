		-
			message: "#^Property App\\\\Services\\\\Embedding\\\\OllamaEmbeddingClient\\:\\:\\$host is never read, only written\\.$#"
			count: 1
			path: app/Services/Embedding/OllamaEmbeddingClient.php

		# spatie/crawler 9.3 uses PHP 8.4 property hooks in CrawlProgress, which
		# PHPStan cannot parse when running under PHP 8.2 compatibility.
		# This is a vendor incompatibility — our code is correct.
		-
			message: "#^Parameter .+ of method App\\\\Services\\\\Crawling\\\\ReplyIqCrawlObserver\\:\\:crawled\\(\\) has invalid type Spatie\\\\Crawler\\\\CrawlProgress\\.$#"
			count: 1
			path: app/Services/Crawling/ReplyIqCrawlObserver.php
